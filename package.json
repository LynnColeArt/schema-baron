{
  "name": "schema-baron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "verify": "node scripts/workspace/verify.mjs all",
    "typecheck": "node scripts/workspace/verify.mjs typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/workspace/verify.mjs build",
    "lint": "node scripts/workspace/verify.mjs lint",
    "check:credentials": "node scripts/workspace/verify.mjs credentials",
    "check:dependencies": "node scripts/workspace/dependencies.mjs verify",
    "check:generated": "node scripts/workspace/verify.mjs generated",
    "native:smoke": "node scripts/workspace/verify.mjs sqlite",
    "native:verify": "node scripts/workspace/native.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
