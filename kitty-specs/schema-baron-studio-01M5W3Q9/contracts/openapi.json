      }
    },
    "/jobs/{jobId}": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "inspectJob",
        "responses": {
          "200": {
            "description": "Observed job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelJob",
        "responses": {
          "200": {
            "description": "Structured command outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Outcome"
                }
              }
            }
          },
          "409": {
            "description": "Structured command outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Outcome"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/events": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "afterSequence",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ],
      "get": {
        "operationId": "projectEvents",
        "responses": {
          "200": {
            "description": "Sequenced project revision/job/diagnostic events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ownerCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Owner-scoped local capability; browser uses protected same-origin session exchange. Never a generated-app visitor token."
      }
    },
    "schemas": {
      "Diagnostic": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "objectId": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      },
      "Command": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "project.batch",
              "project.export",
              "connection.inspect",
              "connection.bind",
              "schema.preview",
              "schema.apply",
              "schema.history",
              "schema.restorePreview",
              "query.preview",
              "form.construct",
              "project.validate",
              "flow.inspect",
              "generation.preview",
              "generation.apply",
              "runtime.start",
              "runtime.stop",
              "runtime.status",
              "extension.read",
              "extension.write",
              "identity.provision"
            ]
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "input": {
            "type": "object",
            "description": "Operation-specific validated schema from commands.md; unknown fields fail against the registered domain schema."
          }
        },
        "required": [
          "requestId",
          "operation",
          "expectedRevision",
          "input"
        ],
        "additionalProperties": false
      },
      "Outcome": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "result": {},
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "objectId": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok",
          "revision",
          "diagnostics"
        ],
        "additionalProperties": false
      },
      "ProjectCreate": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "approvedRoot": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "const": "next-typescript-sqlite"
          }
        },
        "required": [
          "requestId",
          "name",
          "approvedRoot",
          "target"
        ],
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}
