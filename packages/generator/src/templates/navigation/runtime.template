import 'server-only';
import { one, value, entered, type Field, type Parameters } from './record-validation.ts';
export type Expression = { readonly kind:'field'; readonly fieldId:string } | { readonly kind:'parameter'; readonly parameterId:string } | { readonly kind:'literal'; readonly value:string|number|boolean|null };
export type Mapping = { readonly parameter:string; readonly field:Field; readonly expression:Expression };
export type Destination = { readonly path:string; readonly mappings:readonly Mapping[]; readonly newForms:readonly string[] };
export type ContextField = { readonly parameter:string; readonly field?:Field; readonly kind?:'page'|'sort'|'direction'; readonly allowed?:readonly string[] };
export function context(parameters:Parameters, allowed:readonly ContextField[]):Record<string,string> {
 const result:Record<string,string>={};
 for(const item of allowed) {
  const text=one(parameters,item.parameter); if(text===undefined) continue;
  if(item.field) value(item.field,text);
  if(item.kind==='page'&&!/^[1-9]\d{0,4}$/.test(text)) throw Error('Invalid page.');
  if(item.kind==='direction'&&!['asc','desc'].includes(text)) throw Error('Invalid direction.');
  if(item.kind==='sort'&&text!==''&&!item.allowed?.includes(text)) throw Error('Invalid sort field.');
  result[item.parameter]=text;
 }
 return result;
}
export function destination(config:Destination, row:Record<string,unknown>, parameters:Parameters, allowed:readonly ContextField[]):string {
 // The path and mapping names are compiled from declarations; request return URLs
 // and source/table overrides never participate in destination selection.
 const query=new URLSearchParams(context(parameters,allowed));
 for(const mapping of config.mappings) {
  const expr=mapping.expression;
  const raw=expr.kind==='literal'?expr.value:expr.kind==='field'?row[expr.fieldId]:one(parameters,expr.parameterId);
  if(raw===undefined||raw===null&&!mapping.field.nullable) throw Error('A required destination value is missing.');
  const text=expr.kind==='field'?entered(mapping.field,raw):raw===null?'':String(raw); value(mapping.field,text); query.set(mapping.parameter,text);
 }
 for(const id of config.newForms) query.set(id+':mode','new');
 const suffix=query.toString(); return config.path+(suffix?'?'+suffix:'');
}
