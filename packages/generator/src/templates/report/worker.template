import {parentPort,workerData} from 'node:worker_threads';
import Database from 'better-sqlite3';
import {executeQueryPreview} from './query-execute.js';
const db=new Database(workerData.databasePath,{readonly:true,fileMustExist:true});
try {
 db.pragma('query_only = ON');db.pragma('busy_timeout = 1000');db.exec('BEGIN');
 for(const [key,value] of Object.entries(workerData.compiled.parameters))if(value&&typeof value==='object'&&value.type==='Buffer')workerData.compiled.parameters[key]=Buffer.from(value.data);
 const result=executeQueryPreview(db,workerData.compiled);
 parentPort.postMessage({ok:true,result});
}catch{parentPort.postMessage({ok:false});}finally{if(db.inTransaction)db.exec('ROLLBACK');db.close();}
