import 'server-only';
import {Worker} from 'node:worker_threads';
import {pathToFileURL} from 'node:url';
import {join} from 'node:path';
import {databasePath} from './connection.ts';
import {isLiteralValue,parseQueryInput} from './query-scalar.js';
type Parameters=Record<string,string|string[]|undefined>;
type Scalar={readonly kind:string;readonly scale?:number;readonly precision?:number;readonly rounding?:string;readonly encoding?:string};
type Input={readonly id:string;readonly name:string;readonly type:Scalar;readonly nullable:boolean;readonly default?:unknown};
type Mapping={readonly parameterId:string;readonly value?:unknown;readonly runtime?:{readonly name:string}};
type Plan={readonly id:string;readonly aliases?:Readonly<Record<string,string>>;readonly compiled:{readonly sql:string;readonly fields:readonly {readonly id:string;readonly name:string;readonly type:Scalar;readonly nullable:boolean}[];readonly tables:readonly {readonly name:string;readonly columns:readonly string[];readonly uniqueKeys:readonly (readonly string[])[]}[];readonly grainChecks:readonly string[];readonly parameters:Readonly<Record<string,unknown>>;readonly rowLimit:number};readonly inputs:readonly Input[];readonly bindings:Readonly<Record<string,readonly string[]>>};
function one(p:Parameters,key:string){const value=p[key];if(Array.isArray(value))throw Error('Use one value per input.');return value;}
export async function readReport(plan:Plan,mappings:readonly Mapping[],parameters:Parameters,prefix:string){
 try {
  const pageText=one(parameters,prefix+':page')??'1';if(!/^[1-9]\d{0,4}$/.test(pageText))throw Error('Invalid report page.');const page=Number(pageText);
  const allowed=new Set([prefix+':page',...mappings.flatMap(m=>m.runtime?[prefix+':parameter:'+m.runtime.name,prefix+':parameter:'+m.runtime.name+':mode']:[])]);
  for(const key of Object.keys(parameters))if(key.startsWith(prefix+':')&&!allowed.has(key))throw Error('Unknown report input.');
  const bindings:Record<string,unknown>={...plan.compiled.parameters};
  for(const input of plan.inputs){
   const mapping=mappings.find(m=>m.parameterId===input.id);let value=mapping&&!mapping.runtime?mapping.value:input.default;
   if(mapping?.runtime){const key=prefix+':parameter:'+mapping.runtime.name,text=one(parameters,key),mode=one(parameters,key+':mode')??(text===undefined?'default':'value');
    if(!['default','value','null'].includes(mode))throw Error('Invalid input mode.');
    if(mode==='null')value=null;else if(mode==='value'){if(text===undefined)throw Error('Missing input.');value=parseQueryInput(text,input);}
   }
   if(!isLiteralValue(value,input.type,input.nullable))throw Error('A required input is missing or invalid.');
   const encoded=value===null?null:input.type.kind==='boolean'?Number(value):input.type.kind==='blob'?Buffer.from(value as string,'base64'):value;
   for(const slot of plan.bindings[input.id]??[])bindings[slot]=encoded;
  }
  bindings.sb_report_offset=(page-1)*plan.compiled.rowLimit;
  const compiled={...plan.compiled,parameters:bindings};
  const result=await new Promise<{rows:Record<string,unknown>[];truncated:boolean}>((resolve,reject)=>{
   const worker=new Worker(pathToFileURL(join(process.cwd(),'server/query-worker.mjs')),{workerData:{databasePath,compiled}});
   const timer=setTimeout(()=>{void worker.terminate();reject(Error('Report deadline exceeded.'));},5000);
   worker.once('message',message=>{clearTimeout(timer);void worker.terminate();message.ok?resolve(message.result):reject(Error('Report could not be read.'));});
   worker.once('error',error=>{clearTimeout(timer);reject(error);});
   worker.once('exit',code=>{clearTimeout(timer);reject(Error('Report worker stopped before returning a result ('+code+').'));});
  });
  return {...result,rows:plan.aliases?result.rows.map(row=>Object.fromEntries(Object.entries(row).map(([key,value])=>[plan.aliases![key]??key,value]))):result.rows,page};
 }catch{return {rows:[] as Record<string,unknown>[],page:1,truncated:false,error:'The report could not be read. Check its declared parameters, data types and database.'};}
}
