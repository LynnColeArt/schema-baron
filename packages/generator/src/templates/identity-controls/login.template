'use client';
import { useState } from 'react';
import { Csrf } from './csrf';
export function Login({username,password,usernameLabel,passwordLabel,actions,returnTo,cancelTo}:{username:string;password:string;usernameLabel:string;passwordLabel:string;actions:{id:string;operation:string;label?:string}[];returnTo:string;cancelTo:string}) {
 const [error,setError]=useState(''),[busy,setBusy]=useState(false);
 return <section aria-label="Visitor sign in">{returnTo&&<p>Sign in to continue to the selected page. Your selected record and list filters will be retained.</p>}<form onSubmit={async event=>{event.preventDefault();const form=event.currentTarget;const native=event.nativeEvent as SubmitEvent;const data=new FormData(form);const button=native.submitter as HTMLButtonElement|null;if(button)data.set('_action',button.value);const secret=form.elements.namedItem(password) as HTMLInputElement|null;if(secret)secret.value='';setError('');setBusy(true);try{const response=await fetch('/runtime/auth',{method:'POST',body:data});const result=await response.json();if(response.ok)location.assign(result.location);else setError(result.error??'Sign in failed. Try again.');}catch{setError('Sign in is unavailable. Check the connection and try again.');}finally{setBusy(false);}}}><Csrf/><input type="hidden" name="returnTo" value={returnTo}/><label>{usernameLabel}<input name={username} autoComplete="username" required/></label><label>{passwordLabel}<input name={password} type="password" autoComplete="current-password" required/></label>{actions.filter(a=>a.operation==='login').map(a=><button disabled={busy} key={a.id} name="_action" value={a.id}>{a.label??'Sign in'}</button>)}{error&&<p role="alert">{error}</p>}<a href={cancelTo}>{actions.find(a=>a.operation==='cancel')?.label??'Cancel'}</a></form></section>;
}
