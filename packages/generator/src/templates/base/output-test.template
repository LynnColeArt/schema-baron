import {test} from 'node:test';
import assert from 'node:assert/strict';
import {mkdtempSync,rmSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import Database from 'better-sqlite3';
test('prepared allowlisted reads, paging and formatting use disposable test data',async()=>{
 const root=mkdtempSync(join(tmpdir(),'generated-read-test-'));const path=join(root,'test.sqlite');
 process.env.APPLICATION_DATABASE_PATH=path;
 const db=new Database(path);db.exec('CREATE TABLE "odd "" table"("key" TEXT PRIMARY KEY,"label" TEXT)');db.prepare('INSERT INTO "odd "" table" VALUES(?,?)').run('a',"100% actual");db.prepare('INSERT INTO "odd "" table" VALUES(?,?)').run('b','Another');db.close();
 try {
 const {readGrid}=await import('../server/repository.ts');const {formatValue}=await import('../server/format.ts');
 const decimalDb=new Database(path);
 decimalDb.exec('CREATE TABLE nullable_decimals(id INTEGER PRIMARY KEY,amount TEXT,scaled INTEGER)');
 const decimalInsert=decimalDb.prepare('INSERT INTO nullable_decimals VALUES(?,?,?)');
 decimalInsert.run(1,'1000000000000000000.25',100000000000000025n);
 decimalInsert.run(2,'9.75',975n);
 decimalInsert.run(3,null,null);
 decimalInsert.run(4,'0.00',0n);
 decimalDb.close();
 const decimalConfig={table:'nullable_decimals',fields:[{id:'id',name:'id',type:{kind:'integer'},nullable:false},{id:'amount',name:'amount',type:{kind:'decimal',scale:2,encoding:'text'},nullable:true},{id:'scaled',name:'scaled',type:{kind:'decimal',scale:2,encoding:'scaled-integer'},nullable:true}],search:[],sorting:[{fieldId:'scaled',direction:'asc'}],pageSize:20};
 assert.deepEqual(readGrid(decimalConfig,{},'decimal').rows.map(row=>row.id),[3n,4n,2n,1n]);
 const decimals=(operator,text)=>readGrid({...decimalConfig,search:[{fieldId:'amount',operator}]},{'decimal:filter:amount':text},'decimal');
 for(const [operator,value,expected] of [['eq','1000000000000000000.25',[1n]],['eq','0.00',[4n]],['gte','10.00',[1n]],['lte','10.00',[4n,2n]]]) {
  const result=decimals(operator,value);
  assert.equal(result.error,undefined);
  assert.deepEqual(result.rows.map(row=>row.id),expected);
 }
 assert.equal(formatValue(null,{kind:'decimal',scale:2,encoding:'text'},'plain'),'—');
 const config={table:'odd " table',fields:[{id:'key-id',name:'key',type:{kind:'text'},nullable:false},{id:'label-id',name:'label',type:{kind:'text'},nullable:true}],search:[{fieldId:'label-id',operator:'contains'}],sorting:[{fieldId:'key-id',direction:'asc'}],pageSize:1};
 assert.equal(readGrid(config,{},'grid').rows[0]['key-id'],'a');assert.equal(readGrid(config,{'grid:page':'2'},'grid').rows[0]['key-id'],'b');assert.equal(readGrid(config,{'grid:filter:label-id':"' OR 1=1 --"},'grid').rows.length,0);assert.equal(readGrid(config,{'grid:filter:label-id':'%'},'grid').rows[0]['key-id'],'a');assert.ok(readGrid(config,{'grid:sort':'forged'},'grid').error);assert.ok(readGrid(config,{'grid:filter:unknown':'bad'},'grid').error);assert.ok(readGrid(config,{'grid:page':'-1'},'grid').error);assert.equal(formatValue(1234n,{kind:'decimal',scale:2,encoding:'scaled-integer'},'currency'),'$12.34');assert.equal(formatValue(null,{kind:'text'},'plain'),'—');
 }finally{rmSync(root,{recursive:true,force:true});}
});
