{
  "name": "@schema-baron/generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./navigation": {
      "types": "./src/templates/navigation/index.ts",
      "default": "./dist/templates/navigation/index.js"
    },
    "./behavior": {
      "types": "./src/behavior/index.ts",
      "default": "./dist/behavior/index.js"
    }
  },
  "dependencies": {
    "@schema-baron/model": "0.0.0",
    "@schema-baron/sqlite": "0.0.0",
    "better-sqlite3": "13.0.3"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-templates.mjs"
  }
}
